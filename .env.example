# Balloon Dior Backend Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ===== SUPABASE DATABASE =====
# Get these from https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# ===== EMAIL SERVICE (Gmail SMTP) =====
# See: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ===== AUTHENTICATION =====
# Generate random secret keys (at least 32 characters)
JWT_SECRET=your-random-jwt-secret-key-min-32-chars-123456789
SUPER_JWT_SECRET=your-random-super-jwt-secret-key-min-32-chars
JWT_EXPIRE=24h

# ===== SUPERADMIN CONFIGURATION =====
# The email address where admin registration requests are sent
SUPERADMIN_EMAIL=admin@example.com

# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=5000

# ===== OPTIONAL: PRODUCTION SETTINGS =====
# Uncomment these when deploying to production
# FRONTEND_URL=https://balloondior.com
# BACKEND_URL=https://api.balloondior.com
# NODE_ENV=production
